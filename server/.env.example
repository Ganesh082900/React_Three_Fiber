# Copy to .env and fill in. Never commit .env.
PORT=5000

# Origin of the frontend allowed to call this API (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# SMTP account used to send the email. For Gmail, use an App Password, not your account password.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=

# Where contact messages are delivered.
MAIL_TO=